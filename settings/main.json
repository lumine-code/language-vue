{
  ".text.html.vue": {
    "autocomplete": {
      // Vue directives and component names are hyphenated — `v-if`, `x-data`,
      // `<my-widget>` — so a hyphen has to count as part of a word or every
      // completion stops at the dash.
      "extraWordCharacters": "-"
    },
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''"]
    },
    "editor": {
      "commentStart": "<!-- ",
      "commentEnd": " -->",
      "commentDelimiters": {
        "block": ["<!--", "-->"]
      },
      "increaseIndentPattern": "(?x)\n<(?!\\?|(?:area|base|br|col|frame|hr|html|img|input|link|meta|param)\\b|[^>]*/>)\n([-_\\.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*</\\1>)\n|<!--(?!.*-->)\n|\\{[^}\"']*$",
      "decreaseIndentPattern": "(?x)\n^\\s*\n(</(?!html)\n  [-_\\.A-Za-z0-9]+\\b[^>]*>\n  |-->\n  |\\}\n)"
    }
  }
}
