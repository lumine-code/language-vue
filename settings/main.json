{
  ".text.html.vue": {
    "autocomplete": {
      // Vue directives and component names are hyphenated — `v-if`, `x-data`,
      // `<my-widget>` — so a hyphen has to count as part of a word or every
      // completion stops at the dash.
      "extraWordCharacters": "-"
    },
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''"]
    },
    "editor": {
      "commentStart": "<!-- ",
      "commentEnd": " -->",
      "commentDelimiters": {
        "block": ["<!--", "-->"]
      }
    }
  }
}
